# Copy to .env; configure the key locally. Never place secrets in VITE_* variables.
# Official docs: https://api-docs.deepseek.com/guides/codex
# OpenAI-compatible base URL: https://api.deepseek.com
# This example intentionally contains no credential and must remain safe to commit.
LLM_PROVIDER=deepseek
LLM_PROTOCOL=openai-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=20000
LLM_CONCURRENCY=4
LLM_REQUEST_LIMIT=500
PORT=4321
